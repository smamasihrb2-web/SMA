name: Build APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Extract or Prepare Project
        run: |
          mkdir -p src
          # Check for any zip file in the repo
          ZIP_FILE=$(find . -maxdepth 2 -name "*.zip" | head -n 1)
          if [ -n "$ZIP_FILE" ]; then
            echo "Found ZIP file: $ZIP_FILE. Extracting..."
            unzip -q -o "$ZIP_FILE" -d src
          else
            echo "No zip file found. Looking for existing project directories..."
            if [ -d "Planner" ]; then
              cp -r Planner src/
            elif [ -d "app" ]; then
              mkdir -p src/Planner
              cp -r * src/Planner/ 2>/dev/null || true
            fi
          fi

          # Clean any stale cache or lock files
          rm -rf .gradle src/*/.gradle src/*/*/.gradle
          find . -name "*.lock" -delete 2>/dev/null || true

          # Find the Android project directory containing build.gradle
          if [ -f "src/Planner/build.gradle.kts" ] || [ -f "src/Planner/build.gradle" ]; then
            TARGET_DIR="src/Planner"
          elif [ -f "Planner/build.gradle.kts" ] || [ -f "Planner/build.gradle" ]; then
            TARGET_DIR="Planner"
          elif [ -f "build.gradle.kts" ] || [ -f "build.gradle" ]; then
            TARGET_DIR="."
          else
            SEARCH_GRADLE=$(find . -name "build.gradle*" | grep -v "/app/" | head -n 1)
            if [ -n "$SEARCH_GRADLE" ]; then
              TARGET_DIR=$(dirname "$SEARCH_GRADLE")
            else
              echo "Error: Could not find build.gradle in repository."
              exit 1
            fi
          fi
          
          echo "TARGET_DIR=$TARGET_DIR" >> $GITHUB_ENV
          echo "Selected project directory: $TARGET_DIR"

      - name: Setup local.properties and gradle.properties
        run: |
          echo "sdk.dir=/usr/local/lib/android/sdk" > "$TARGET_DIR/local.properties"
          printf "android.useAndroidX=true\norg.gradle.jvmargs=-Xmx4g -XX:+HeapDumpOnOutOfMemoryError\nkotlin.daemon.jvmargs=-Xmx2g\n" > "$TARGET_DIR/gradle.properties"

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Accept Android Licenses
        run: yes | /usr/local/lib/android/sdk/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Set up Gradle 8.7
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      - name: Build APK with Gradle
        run: |
          cd "$TARGET_DIR"
          chmod +x gradlew
          # Build APK cleanly
          ./gradlew assembleDebug --stacktrace 2>&1 | tee build_output.log || {
            echo "::error::Build failed! Last 60 log lines:"
            tail -n 60 build_output.log
            exit 1
          }

      - name: Check Built APK Files
        run: |
          echo "=== Found APK files ==="
          find . -name "*.apk"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: planner-apk
          path: "**/*.apk"
          if-no-files-found: warn
