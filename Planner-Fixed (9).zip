300/20 via-sky-200/15 to-white/40"}:x>=80&&x<=82?{title:"رگبار باران",desc:"رگبارهای پراکنده و متناوب",icon:"🌦️",image:"https://images.unsplash.com/photo-1534274988757-a28bf1a57c17?w=500&auto=format&fit=crop&q=80",themeBg:"from-blue-600/20 via-sky-300/15 to-slate-100/30"}:x>=85&&x<=86?{title:"رگبار برف",desc:"بارش ناگهانی و رگباری برف",icon:"🌨️",image:"https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=500&auto=format&fit=crop&q=80",themeBg:"from-slate-400/20 via-blue-200/15 to-white/40"}:x>=95?{title:"رعد و برق و طوفان",desc:"طوفان تندری همراه با صاعقه",icon:"⛈️",image:"https://images.unsplash.com/photo-1605727216801-e27ce1d0cc28?w=500&auto=format&fit=crop&q=80",themeBg:"from-purple-900/20 via-indigo-600/15 to-slate-800/10"}:{title:"هوای معتدل",desc:"شرایط آب و هوایی پایدار",icon:"🌤️",image:"https://images.unsplash.com/photo-1534088568595-a066f410bcda?w=500&auto=format&fit=crop&q=80",themeBg:"from-emerald-400/20 via-teal-300/15 to-lime-50/30"}}const U_=["یکشنبه","دوشنبه","سه‌شنبه","چهارشنبه","پنج‌شنبه","جمعه","شنبه"];async function lg(x=35.6892,v=51.389,g="تهران"){var m,N,R,O,I,V,lt;try{const Y=`https://api.open-meteo.com/v1/forecast?latitude=${x}&longitude=${v}&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto`,z=await fetch(Y);if(!z.ok)throw new Error(`Weather fetch failed: ${z.statusText}`);const J=await z.json(),Z=((m=J.current)==null?void 0:m.weather_code)??0,q=Math.round(((N=J.current)==null?void 0:N.temperature_2m)??22),M=Math.round(((R=J.current)==null?void 0:R.relative_humidity_2m)??40),F=Math.round(((O=J.current)==null?void 0:O.wind_speed_10m)??8),ot=[];if(J.daily&&Array.isArray(J.daily.time))for(let St=0;St<Math.min(7,J.daily.time.length);St++){const mt=J.daily.time[St],Ct=new Date(mt),dt=St===0?"امروز":St===1?"فردا":U_[Ct.getDay()],Bt=((I=J.daily.weather_code)==null?void 0:I[St])??0;ot.push({date:mt,dayName:dt,weatherCode:Bt,condition:Ei(Bt),maxTemp: