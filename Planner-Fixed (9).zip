<script>
  (function() {
    window.alert = function(msg) {
      console.log("[Notice]:", msg);
      try {
        var existing = document.getElementById("sma-iframe-toast");
        if (existing) existing.remove();
        var toast = document.createElement("div");
        toast.id = "sma-iframe-toast";
        toast.style.cssText = "position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#18181b;color:#f4f4f5;padding:10px 18px;border-radius:12px;font-family:inherit;font-size:13px;font-weight:600;box-shadow:0 10px 25px rgba(0,0,0,0.3);z-index:99999;max-width:90%;text-align:center;direction:rtl;border:1px solid #3f3f46;";
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() {
          toast.style.opacity = "0";
          toast.style.transition = "opacity 0.3s";
          setTimeout(function() { toast.remove(); }, 300);
        }, 3200);
      } catch(e) {}
    };
    window.addEventListener('error', function(e) {
      console.error('SMA Startup Error:', e.message || e);
      var txt = document.getElementById('sma-loading-text');
      if (txt) {
        txt.innerHTML = '<span style="color:#d9534f;font-weight:bold;">خطا در بارگذاری اولیه: ' + (e.message || e) + '</span><br><button onclick="try{localStorage.clear()}catch(x){};location.reload();" style="margin-top:14px;padding:8px 18px;background:#111111;color:#D7F14F;border:none;border-radius:10px;font-family:inherit;font-weight:bold;font-size:13px;cursor:pointer;">پاکسازی حافظه و تلاش مجدد</button>';
      }
    });
  })();
</script>
<script src="/_aistudio-iframe.js?v=1f94f900"></script></head>
  <body class="bg-[#F4F7EA] text-[#111111]">
    <div id="root">
      <div style="display:flex;height:100vh;align-items:center;justify-content:center;background-color:#F4F7EA;font-family:sans-serif;direction:rtl;">
        <div style="text-align:center;">
          <div style="width:52px;height:52px;border-radius:18px;background:#111111;color:#D7F14F;display:inline-flex;align-items:center;justify-content:center;font-weight:bold;font-size:22px;margin-bottom:14px;box-shadow:0 8px 16px rgba(0,0,0,0.15);">SMA</div>
          <div style="font-size:14px;color:#333;font-weight:bold;margin-bottom:6px;">پلنر هوشمند روز من</div>
          <div id="sma-loading-text" style="font-size:11px;color:#888;">در حال آماده‌سازی محیط برنامه...</div>
        </div>
      </div>
    </div>
