category:"positive"},{id:7,text:"امروز همان فردایی است که دیروز نگرانش بودی؛ پس با آرامش نفس بکش.",author:"ضرب‌المثل پارسی",category:"positive"},{id:8,text:"آرامش درونی از زمانی آغاز می‌شود که تصمیم بگیری به دیگران اجازه ندهی احساساتت را کنترل کنند.",author:"بودا",category:"positive"},{id:9,text:"هر روز با یک فکر مثبت آغاز می‌شود که می‌تواند تمام سرنوشت امروزت را دگرگون سازد.",author:"زیگ زیگلار",category:"positive"},{id:10,text:"مهربانی زبانی است که ناشنوا می‌تواند بشنود و نابینا می‌تواند ببیند.",author:"مارک تواین",category:"positive"},{id:101,text:"تنها راه انجام کارهای بزرگ، عشق ورزیدن به کاری است که انجام می‌دهی.",author:"استیو جابز",category:"success"},{id:102,text:"پیروزی از آن کسانی است که بیش از دیگران استقامت و پایداری به خرج می‌دهند.",author:"ناپلئون بناپارت",category:"success"},{id:103,text:"فرصت‌ها اتفاق نمی‌افتند، شما خودتان آن‌ها را خلق می‌کنید.",author:"کریس گروسر",category:"success"},{id:104,text:"سخت‌کوشی پلی است میان آرزوهایی که در سر داری و اهدافی که به آن‌ها می‌رسی.",author:"توماس ادیسون",category:"success"},{id:105,text:"محدودیت‌ها تنها در ذهن ما جای دارند؛ باورهایت را آزاد کن تا شگفتی بیافرینی.",author:"ناپلئون هیل",category:"success"},{id:106,text:"موفقیت مجموعه‌ای از تلاش‌های کوچک روزانه‌ای است که پیوسته تکرار می‌شوند.",author:"رابرت کولیر",category:"success"},{id:107,text:"شجاعت یعنی رفتن به پیش وقتی ترس تمام وجودت را گرفته است.",author:"وینستون چرچیل",category:"success"},{id:108,text:"هر شکست فرصتی است برای شروع دوباره، این بار هوشمندانه‌تر و با تجربه‌ای گرانبهاتر.",author:"هنری فورد",category:"success"},{id:109,text:"رویاهایت را بزرگ تصور کن و از کوچک آغاز کن، ولی بی‌درنگ اقدام کن.",author:"رابین شارما",category:"success"},{id:110,text:"هیچ آسانسوری به سوی موفقیت وجود ندارد، پله‌ها را یکی‌یکی با افتخار بالا برو.",author:"زیگ زیگلار",category:"success"},{id:201,text:"دشوارترین کار انسان، شناخت خویشتن است و آسان‌ترین کار، پند دادن به دیگران.",author:"سقراط",category:"elders"},{id:202,text:"گفتار نیک، پندار نیک، کردار نیک؛ ستون‌های جاودان انسانیت.",author:"زرتشت",category:"elders"},{id:203,text:"هیچ گنجی ارزنده‌تر از خرد و دانایی، و هیچ فقری کشنده‌تر از نادانی نیست.",author:"امیرالمؤمنین علی (ع)",category:"elders"},{id:204,text:"تنها آن کس که از اشتباه کردن نمی‌هراسد، می‌تواند مرزهای دانش را جابجا کند.",author:"آلبرت اینشتین",category:"elders"},{id:205,text:"تو چنان باش که می‌نمایی، یا چنان نما که هستی.",author:"بایزید بسطامی",category:"elders"},{id:206,text:"بزرگترین افتخار ما در این نیست که هرگز سقوط نکنیم، بلکه در این است که پس از هر سقوط برخیزیم.",author:"کنفوسیوس",category:"elders"},{id:207,text:"صبر تلخ است ولیکن عاقبت میوه‌اش شیرین‌ترین شهد جهان است.",author:"سعدی شیرازی",category:"elders"},{id:208,text:"جهان آیینه‌ای است که بازتاب باورهای تو را به خودت برمی‌گرداند.",author:"مارکوس اورلیوس",category:"elders"},{id:209,text:"از قضاوت دیگران بیمناک مباش؛ تاریخ را انسان‌های مستقل رقم می‌زنند.",author:"فردریش نیچه",category:"elders"},{id:210,text:"دانش بدون عمل، همانند زنبور بی‌عسل و درختی بی‌ثمر است.",author:"ابن سینا",category:"elders"},{id:301,text:"تو همان چیزی می‌شوی که بیشتر ساعات روز به آن می‌اندیشی.",author:"رالف والدو امرسون",category:"growth"},{id:302,text:"رویای بزرگ داشته باش، برنامه‌ریزی دقیق کن، سخت کار کن و فروتن بمان.",author:"جیم ران",category:"growth"},{id:303,text:"بزرگترین سرمایه‌گذاری زندگی‌ات، سرمایه‌گذاری روی ذهن، روان و توانمندی‌های خودت است.",author:"وارن بافت",category:"growth"},{id:304,text:"هرگز خودت را با دیگران مقایسه نکن؛ تنها رقیب امروزت، نسخه دیروز خودت است.",author:"ارنست همینگوی",category:"growth"},{id:305,text:"نظم و استمرار روزانه، پلی است که ایده‌ها را به واقعیت‌های ملموس تبدیل می‌کند.",author:"برایان تریسی",category:"growth"},{id:306,text:"آینده از آنِ کسانی است که زیبایی رویاهایشان را صمیمانه باور دارند.",author:"النور روزولت",category:"growth"},{id:307,text:"عادت‌های کوچک تو در طول زمان سرنوشت‌های باشکوه را می‌سازند.",author:"جیمز کلیر",category:"growth"},{id:308,text:"تمرکز روی یک هدف شفاف، قدرت‌های خفته درونت را بیدار می‌کند.",author:"آنتونی رابینز",category:"growth"},{id:309,text:"اگر کشتی‌ات را به ساحل امن ببندی هرگز غرق نخواهی شد، اما کشتی‌ها برای ماندن در ساحل ساخته نشده‌اند.",author:"جان شود",category:"growth"},{id:310,text:"وقتی باور داشته باشی که لایق دستاوردهای بزرگ هستی، مسیرها گشوده خواهند شد.",author:"نلسون ماندلا",category:"growth"}];function P_(){const x=[...q_],v=["امروز با قلبی سرشار از امید گام بردار؛","هر طلوع آفتاب نشانی است از رحمت بی‌پایان جهان؛","زیبایی درون تو نوری است که تاریکی را می‌شکافد؛","در طوفان‌های زندگی، سکان آرامش در دستان توست؛","به جریان شگفت‌انگیز هستی اعتماد کن؛","زندگی زمانی سرشار از شگفتی می‌شود که شکرگزار باشی؛","لبخند امروز تو نغمه‌ای است از عشق برای جهانیان؛","هر نفس، هدیه‌ای ناب و دعوتی است به زیستن در روشنایی؛"],g=["چرا که شادی در پذیرش زیبایی‌های ساده پیرامون توست.","و معجزه‌ها دقیقاً در لحظاتی رخ می‌دهند که ایمان داری.","آرام باش و از نغمه‌های پنهان درون خود لذت ببر.","نور امید همیشه در تیره‌ترین شب‌ها چشمک می‌زند.","زیرا فردا زیباتر از تصورات امروزی تو شکوفا خواهد شد.","و مهرورزی، بزرگ‌ترین زره روحی انسان در گذر زمان است."],m=["سعدی","مولوی","حافظ","حکمت کهن","پیام مثبت روز","سهراب سپهری","خیام"],N=["پشتکار فولادین تو راهی نو باز خواهد کرد؛","موانع آمده‌اند تا به تو نشان دهند چقدر مصمم هستی؛","برنامه‌ریزی دقیق، نیمه اصلی هر پیروزی درخشان است؛","تسلیم نشدن راز تمام قهرمانان خاموش تاریخ است؛","گام‌های کوچک اما پیوسته، کوه‌های سترگ را هموار می‌کنند؛","اراده تو فراتر از هر سدی است که پیش رویت نهاده‌اند؛"],R=["تا زمانی که ادامه می‌دهی، هرگز بازنده نخواهی بود.","پیروزی نهایی پاداش کسانی است که تا آخرین نفس می‌کوشند.","به مهارت‌ها و قدرت نامحدود خودت تکیه کن.","شکست‌ها تنها نقشه‌های راه برای پروازی بلندتر هستند.","امروز تصمیم بگیر که فردا را با دستاوردهایت شگفت‌زده کنی."],O=["استیو جابز","ایلان ماسک","هنری فورد","ناپلئون هیل","کوروش بزرگ","امیرکبیر","توماس ادیسون"],I=["حکمت در این است که بدانی چه چیز ارزش اندیشیدن دارد؛","راستی و درستی گنجینه‌ای است که هیچ دزدی بدان دست نیابد؛","انسان آزاده در بند هوس‌های زودگذر گرفتار نمی‌شود؛","خردمند کسی است که از خطای گذشته پند گیرد و راه نو گزیند؛","سکوت در برابر نادانی، بلندترین فریاد عقلانیت است؛"],V=["همان‌گونه که بزرگان ما تاریخ را با خرد رقم زدند.","چون عدالت، گوهر تابان روان آدمی در تمام اعصار است.","و اخلاق نیکو، سرمایه‌ای جاودان برای آیندگان است.","زیرا دانایی، تنها چراغ روشنگر ظلمت انسان‌هاست."],lt=["ابن سینا","فارابی","خیام نیشابوری","افلاطون","ارسطو","فردوسی بزرگ","ابوریحان بیرونی"],Y=["خودت را در آغوش بگیر و برای فردایت بجنگ؛","یادگیری مداوم، اکسیر جوانی و پویایی ذهن است؛","عادت‌هایت را تغییر بده تا دنیایت دگرگون شود؛","نهایت شجاعت در این است که خودت باشی بدون نقاب؛","هر بار که از منطقه آسایش بیرون می‌آیی، ده پله رشد می‌کنی؛"],z=["تو آفریننده داستان شگفت‌انگیز زندگی خویشتنی.","باور به توانمندی‌هایت، جادویی‌ترین اکسیر جهان است.","زیرا هر انسان جهانی پهناور و بی‌کران در درون خود دارد.","به کارهای کوچک روزانه‌ات ارج بنه، سرنوشتت در آنهاست."],J=["جیمز کلیر","کارل گوستاو یونگ","کارل راجرز","جیم ران","سهروردی","عطار نیشابوری"];let Z=400;for(let q of v)for(let M of g)for(let F of m.slice(0,5))x.push({id:Z++,text:`${q} ${M}`,author:F,category:"positive"});for(let q of N)for(let M of R)for(let F of O.slice(0,5))x.push({id:Z++,text:`${q} ${M}`,author:F,category:"success"});for(let q of I)for(let M of V)for(let F of lt.slice(0,5))x.push({id:Z++,text:`${q} ${M}`,author:F,category:"elders"});for(let q of Y)for(let M of z)for(let F of J.slice(0,5))x.push({id:Z++,text:`${q} ${M}`,author:F,category:"growth"});return x}function og(x=["positive","success","elders","growth"]){const v=P_(),g=v.filter(R=>x.includes(R.category)),m=g.length>0?g:v,N=Math.floor(Math.random()*m.length);return m[N]}class Y_{constructor(){Cs(this,"ctx",null);Cs(this,"currentAzanAudio",null);Cs(this,"currentAzanOscillators",[]);Cs(this,"currentBirthdayOscillators",[]);Cs(this,"isAzanPlaying",!1);Cs(this,"isBirthdayPlaying",!1)}getContext(){if(!this.ctx||this.ctx.state==="suspended"){const v=window.AudioContext||window.webkitAudioContext;this.ctx=new v}return this.ctx.state==="suspended"&&this.ctx.resume(),this.ctx}playChime(v="gentle"){